# Интерфейс и ключи AmneziaWG
WG_INTERFACE=amnw0
PRIVATE_KEY="replace-me"
ADDRESS=10.0.0.2/32
# Пусто — сохранить системный DNS. Если указан IPv4 DNS, его /32 автоматически
# добавляется в AllowedIPs, а awg-quick временно настраивает его через resolvconf.
DNS=
PUBLIC_KEY="replace-me"
PRESHARED_KEY="replace-me"
ENDPOINT=198.51.100.10:51820
PERSISTENTKEEPALIVE=25
# auto использует расчёт awg-quick: MTU маршрута к endpoint минус 80.
# Число задаёт фиксированный MTU, например WG_MTU=1390.
WG_MTU=auto

# Параметры обфускации AmneziaWG
Jc=4
Jmin=40
Jmax=70
S1=0
S2=0
S3=0
S4=0
H1=1
H2=2
H3=3
H4=4

# Upstream-прокси в формате host:port:user:password
PROXY_STRING="203.0.113.10:3128:user:replace-me"
LOCAL_HTTP_PORT=8081
LOCAL_SOCKS_PORT=8080
PROXY_PARENT_RETRIES=2

# off — не проверять при старте; warn — предупредить; strict — откатить запуск.
STARTUP_HEALTHCHECK=warn
HEALTHCHECK_URL=https://api.ipify.org

# Только для 3proxy 0.9.6+ и обхода проблем PMTUD.
# Обычно достаточно корректного WG_MTU.
# PROXY_MAXSEG=1350

# HTTPS-адреса списков IPv4 CIDR, разделённые пробелами. Можно оставить пустым.
IPLIST_URLS=""
