# Интерфейс и ключи AmneziaWG
# После заполнения: ./amnezia-proxy-manager config validate
WG_INTERFACE=amnw0
PRIVATE_KEY="replace-me"
ADDRESS=10.0.0.2/32
# Пусто — сохранить системный DNS. Если указан IPv4 DNS, его /32 автоматически
# добавляется в AllowedIPs, а awg-quick временно настраивает его через resolvconf.
DNS=
PUBLIC_KEY="replace-me"
PRESHARED_KEY="replace-me"
# Если на сервере PSK не используется, задайте PRESHARED_KEY=.
ENDPOINT=198.51.100.10:51820
PERSISTENTKEEPALIVE=25
# auto использует расчёт awg-quick: MTU маршрута к endpoint минус 80.
# Число задаёт фиксированный MTU, например WG_MTU=1390.
WG_MTU=auto

# Блокировать исходящий IPv6 всех локальных процессов, кроме loopback.
# off — отключить эту защиту (IPv6 endpoint всё равно не поддерживается).
BLOCK_IPV6=on

# Параметры обфускации AmneziaWG
Jc=4
Jmin=40
Jmax=70
S1=0
S2=0
S3=0
S4=0
H1=1
H2=2
H3=3
H4=4

# Upstream-прокси в формате host:port:user:password
PROXY_STRING="203.0.113.10:3128:user:replace-me"
LOCAL_HTTP_PORT=8081
LOCAL_SOCKS_PORT=8080
PROXY_PARENT_RETRIES=2

# Проверяются HTTP и SOCKS, успешным считается только HTTP 2xx.
# off — не проверять при старте; warn — предупредить; strict — откатить запуск.
STARTUP_HEALTHCHECK=warn
HEALTHCHECK_URL=https://api.ipify.org

# Только для 3proxy 0.9.6+ и обхода проблем PMTUD.
# Обычно достаточно корректного WG_MTU.
# PROXY_MAXSEG=1350

# Маршруты VPN: IPv4/CIDR через пробелы или запятые; IP без маски означает /32.
# Например ALLOWED_IPS="192.0.2.7,198.51.100.0/24".
# Если ALLOWED_IPS и IPLIST_URLS пусты/отсутствуют, используется 0.0.0.0/0:
# весь IPv4 без более специфичных системных маршрутов идёт через VPN.
ALLOWED_IPS=""
# HTTPS-адреса списков, разделённые пробелами; объединяются с ALLOWED_IPS.
# Ответ: IPv4/CIDR через строки, пробелы или запятые; # — комментарий.
# Ошибка скачивания или ответ без валидных адресов запрещает запуск.
IPLIST_URLS=""

# Песочница для AI-агентов (amnezia-proxy run). Требует уже запущенный start.
# Имя network namespace; адрес /30 задаёт пару host/namespace для veth.
SANDBOX_NETNS_NAME=apm-sandbox
SANDBOX_VETH_SUBNET=10.200.0.0/30
# Дополнительные пути (абсолютные, через пробел), которые скрыть от агента.
# Конфиг, ~/.ssh, ~/.aws, ~/.gnupg и облачные creds скрываются всегда.
SANDBOX_HIDE_PATHS=""
# Исключения NO_PROXY (через запятую, без пробелов). По умолчанию пусто — весь
# proxy-aware приложения используют VPN-прокси. Loopback хоста недоступен,
# но wildcard host-сервисы могут быть доступны через veth до добавления guard.
SANDBOX_NO_PROXY=""
# Если задан IPv4 — fail-closed сверка фактического выходного IP перед запуском
# агента. Требует, чтобы HEALTHCHECK_URL возвращал сырой IP (напр. api.ipify.org).
SANDBOX_EXPECTED_EXIT_IP=""
